{
    "name": "@wpazderski/node-package-tools",
    "version": "2.0.3",
    "description": "Common Node.js package tools",
    "keywords": [
        "node",
        "package",
        "tools"
    ],
    "author": "Witold Pazderski",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/wpazderski/node-package-tools.git"
    },
    "homepage": "https://github.com/wpazderski/node-package-tools",
    "bugs": {
        "url": "https://github.com/wpazderski/node-package-tools/issues"
    },
    "type": "module",
    "exports": {
        ".": "./dist/exportsIndex.js",
        "./checkLicenses": "./dist/checkLicenses/checkLicenses.js",
        "./checkOutdatedPackages": "./dist/checkOutdatedPackages/checkOutdatedPackages.js"
    },
    "files": [
        "dist"
    ],
    "bin": {
        "check-licenses": "./dist/checkLicenses/checkLicenses.js",
        "check-outdated-packages": "./dist/checkOutdatedPackages/checkOutdatedPackages.js"
    },
    "scripts": {
        "prepare": "husky",
        "build": "rimraf ./dist/ && rimraf -g ./node_modules/.tmp/*.tsbuildinfo && tsc -b",
        "test": "node --test \"src/**/*.test.ts\"",
        "lint-check": "eslint ./ --flag unstable_native_nodejs_ts_config --max-warnings 0",
        "lint-fix": "eslint ./ --flag unstable_native_nodejs_ts_config --max-warnings 0 --fix",
        "prettier-check": "prettier ./ --check",
        "prettier-fix": "prettier ./ --write",
        "tsc-check": "tsc -b --noEmit",
        "check-licenses": "node ./src/checkLicenses/checkLicenses.ts",
        "check-outdated-packages": "node ./src/checkOutdatedPackages/checkOutdatedPackages.ts",
        "check-all": "run-s lint-check prettier-check tsc-check test check-licenses check-outdated-packages",
        "pre-commit-checks": "run-s check-all"
    },
    "dependencies": {
        "semver": "^7.8.4"
    },
    "devDependencies": {
        "@types/node": "^25.9.3",
        "@types/semver": "^7.7.1",
        "@wpazderski/eslint-config": "^2.0.1",
        "@wpazderski/prettier-config": "^2.0.1",
        "@wpazderski/typescript-config": "^2.0.1",
        "eslint": "^10.5.0",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@10.11.0",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    }
}

{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@wpazderski/typescript-config/baseNodeJs.tsconfig.json",
    "compilerOptions": {
        /* Visit https://aka.ms/tsconfig to read more about this file */

        /* Projects */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.src.tsbuildinfo",

        /* Modules */
        "rootDir": "./src/",

        /* Emit */
        "outDir": "./dist/"
    },
    "include": ["src/**/*"],
    // A test file is not part of the published package. `files: ["dist"]` publishes whatever `dist` holds, so an
    // emitted `*.test.js` reached all three consumers and made the package import `node:test`.
    "exclude": ["src/**/*.test.ts"]
}
